{
  "manifest_version": 2,
  "name": "Marching Orders",
  "version": "0.1.0",
  "description": "Write a sentence, get a small tool that runs on its own, within limits Firefox enforces. Prototype.",
  "browser_specific_settings": {
    "gecko": {
      "id": "marching-orders@fotw.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "sidebar_action": {
    "default_title": "Marching Orders",
    "default_panel": "sidebar.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" },
    "open_at_install": true
  },
  "background": { "scripts": ["background.js"], "persistent": true },
  "permissions": ["storage", "alarms", "notifications", "tabs", "tabHide", "scripting", "downloads", "http://localhost/*", "http://127.0.0.1/*", "https://api.anthropic.com/*"],
  "optional_permissions": ["*://*/*"]
}
